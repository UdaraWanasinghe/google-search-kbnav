{
  "manifest_version": 3,
  "name": "Google Search Keyboard Navigator",
  "version": "1.0.0",
  "description": "Navigate and open Google search results with keyboard shortcuts: j/k or arrows to move, Enter to open, numbers to jump, and more.",
  "content_scripts": [
    {
      "matches": [
        "*://www.google.com/search*",
        "*://www.google.co.uk/search*",
        "*://www.google.ca/search*",
        "*://www.google.com.au/search*",
        "*://www.google.de/search*",
        "*://www.google.fr/search*",
        "*://www.google.co.in/search*",
        "*://www.google.co.jp/search*",
        "*://www.google.es/search*",
        "*://www.google.it/search*",
        "*://www.google.nl/search*",
        "*://www.google.com.br/search*",
        "*://www.google.co.id/search*",
        "*://www.google.com.mx/search*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
